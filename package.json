{
  "name": "wechat-request",
  "version": "3.0.0",
  "description": "基于Promise微信小程序http请求，轻便，小巧，api友好，功能丰富",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "test": "vitest run",
    "test:build": "pnpm build && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint -c ./.eslintrc.js --ext .ts src/ tests/ example/",
    "lint-prettire": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"example/**/*.ts\""
  },
  "keywords": [
    "request",
    "wechat",
    "promise",
    "http",
    "微信小程序"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hatedMe/wechat-request.git"
  },
  "bugs": {
    "url": "https://github.com/hatedMe/wechat-request/issues"
  },
  "license": "ISC",
  "author": "Atom <7548764@qq.com>",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "12.1.1",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.19.0",
    "@typescript-eslint/parser": "8.19.0",
    "eslint": "8.57.1",
    "prettier": "3.4.2",
    "rollup": "4.24.0",
    "rollup-plugin-dts": "6.1.1",
    "tslib": "2.8.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
